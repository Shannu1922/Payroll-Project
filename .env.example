# Copy to .env and fill in real values. Never commit the real .env.

# MySQL connection string (SQLAlchemy / PyMySQL format):
#   mysql+pymysql://<user>:<password>@<host>/<database>
DATABASE_URL=mysql+pymysql://root:<your-password>@localhost/payroll

# Flask session signing key. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset, main.py generates a random key at startup (sessions reset on restart).
SECRET_KEY=<your-secret-key>
